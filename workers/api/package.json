  },
  "dependencies": {
    "@settleit/core": "workspace:*",
    "@settleit/content": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^4.20250930.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0"
  }
}
